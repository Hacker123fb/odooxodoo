// =============================================================================
// TransitOps – Prisma Schema for PostgreSQL / Prisma Postgres Cloud DB
// FILE: prisma/schema.prisma
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// 1. LOOKUP / CATALOGUE MODELS
// ─────────────────────────────────────────────────────────────────────────────

model VehicleMake {
  id              Int            @id @default(autoincrement())
  name            String         @unique @db.VarChar(80)
  countryOfOrigin String?        @map("country_of_origin") @db.VarChar(60)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  models          VehicleModel[]

  @@map("vehicle_makes")
}

model VehicleType {
  id          Int            @id @default(autoincrement())
  name        String         @unique @db.VarChar(30)
  description String?        @db.VarChar(150)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  models      VehicleModel[]

  @@map("vehicle_types")
}

model FuelType {
  id        Int       @id @default(autoincrement())
  code      String    @unique @db.VarChar(20)
  label     String    @db.VarChar(40)
  unitLabel String    @default("litre") @map("unit_label") @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  vehicles  Vehicle[]
  fuelLogs  FuelLog[]

  @@map("fuel_types")
}

model VehicleModel {
  id            Int         @id @default(autoincrement())
  makeId        Int         @map("make_id")
  vehicleTypeId Int         @map("vehicle_type_id")
  name          String      @db.VarChar(80)
  seatingConfig String?     @map("seating_config") @db.VarChar(30)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  make          VehicleMake @relation(fields: [makeId], references: [id], onDelete: Cascade)
  type          VehicleType @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)
  vehicles      Vehicle[]

  @@unique([makeId, name], name: "uq_vehicle_models_make_name")
  @@map("vehicle_models")
}

model Location {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  address   String?  @db.VarChar(255)
  city      String   @db.VarChar(80)
  state     String   @db.VarChar(60)
  pincode   String?  @db.VarChar(10)
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  isActive  Int      @default(1) @map("is_active") @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([name, city], name: "uq_locations_name_city")
  @@map("locations")
}

model Vendor {
  id              Int              @id @default(autoincrement())
  name            String           @unique @db.VarChar(100)
  contactPhone    String?          @map("contact_phone") @db.VarChar(20)
  contactEmail    String?          @map("contact_email") @db.VarChar(150)
  address         String?          @db.Text
  vendorType      String           @default("OTHER") @map("vendor_type") @db.VarChar(30)
  isActive        Int              @default(1) @map("is_active") @db.SmallInt
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  maintenanceLogs MaintenanceLog[]
  expenses        Expense[]

  @@map("vendors")
}

model FuelStation {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(100)
  address   String?   @db.VarChar(255)
  city      String    @db.VarChar(80)
  state     String    @db.VarChar(60)
  latitude  Decimal?  @db.Decimal(10, 7)
  longitude Decimal?  @db.Decimal(10, 7)
  isActive  Int       @default(1) @map("is_active") @db.SmallInt
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  fuelLogs  FuelLog[]

  @@map("fuel_stations")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  users       User[]

  @@map("roles")
}

// ─────────────────────────────────────────────────────────────────────────────
// 2. CORE USERS & AUTHENTICATION
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                  Int              @id @default(autoincrement())
  roleId              Int              @map("role_id")
  fullName            String           @map("full_name") @db.VarChar(100)
  email               String           @unique @db.VarChar(150)
  passwordHash        String           @map("password_hash") @db.VarChar(255)
  phone               String?          @unique @db.VarChar(20)
  status              String           @default("ACTIVE") @db.VarChar(20)
  lastLogin           DateTime?        @map("last_login") @db.Timestamptz()
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  role                Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  driverProfile       Driver?          @relation("UserDriverProfile")
  createdVehicles     Vehicle[]        @relation("UserCreatedVehicles")
  createdDrivers      Driver[]         @relation("UserCreatedDrivers")
  createdTrips        Trip[]           @relation("UserCreatedTrips")
  createdMaintenances MaintenanceLog[] @relation("UserCreatedMaintenance")
  createdFuelLogs     FuelLog[]        @relation("UserCreatedFuelLogs")
  createdExpenses     Expense[]        @relation("UserCreatedExpenses")
  approvedExpenses    Expense[]        @relation("UserApprovedExpenses")
  notifications       Notification[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// 3. FLEET VEHICLES & DRIVERS
// ─────────────────────────────────────────────────────────────────────────────

model Vehicle {
  id                 Int              @id @default(autoincrement())
  registrationNumber String           @unique @map("registration_number") @db.VarChar(20)
  modelId            Int              @map("model_id")
  fuelTypeId         Int              @map("fuel_type_id")
  year               Int              @db.SmallInt
  capacity           Int              @default(1) @db.SmallInt
  color              String?          @db.VarChar(30)
  chassisNumber      String?          @unique @map("chassis_number") @db.VarChar(50)
  engineNumber       String?          @map("engine_number") @db.VarChar(50)
  insuranceExpiry    DateTime?        @map("insurance_expiry") @db.Date
  licenseExpiry      DateTime?        @map("license_expiry") @db.Date
  purchaseDate       DateTime?        @map("purchase_date") @db.Date
  purchasePrice      Decimal?         @map("purchase_price") @db.Decimal(12, 2)
  currentOdometer    Int              @default(0) @map("current_odometer")
  status             String           @default("ACTIVE") @db.VarChar(20)
  notes              String?          @db.Text
  createdBy          Int              @map("created_by")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  model              VehicleModel     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  fuelType           FuelType         @relation(fields: [fuelTypeId], references: [id], onDelete: Cascade)
  creator            User             @relation("UserCreatedVehicles", fields: [createdBy], references: [id], onDelete: Cascade)
  trips              Trip[]
  maintenanceLogs    MaintenanceLog[]
  fuelLogs           FuelLog[]
  expenses           Expense[]

  @@map("vehicles")
}

model Driver {
  id                     Int       @id @default(autoincrement())
  userId                 Int?      @unique @map("user_id")
  employeeId             String    @unique @map("employee_id") @db.VarChar(20)
  fullName               String    @map("full_name") @db.VarChar(100)
  email                  String?   @unique @db.VarChar(150)
  phone                  String    @unique @db.VarChar(20)
  licenseNumber          String    @unique @map("license_number") @db.VarChar(30)
  licenseExpiry          DateTime  @map("license_expiry") @db.Date
  licenseClass           String    @map("license_class") @db.VarChar(30)
  dateOfBirth            DateTime? @map("date_of_birth") @db.Date
  address                String?   @db.Text
  emergencyContactName   String?   @map("emergency_contact_name") @db.VarChar(100)
  emergencyContactPhone  String?   @map("emergency_contact_phone") @db.VarChar(20)
  joiningDate            DateTime  @map("joining_date") @db.Date
  status                 String    @default("AVAILABLE") @db.VarChar(20)
  profileImage           String?   @map("profile_image") @db.VarChar(255)
  notes                  String?   @db.Text
  createdBy              Int       @map("created_by")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  user                   User?     @relation("UserDriverProfile", fields: [userId], references: [id], onDelete: SetNull)
  creator                User      @relation("UserCreatedDrivers", fields: [createdBy], references: [id], onDelete: Cascade)
  trips                  Trip[]
  fuelLogs               FuelLog[]
  expenses               Expense[]

  @@map("drivers")
}

// ─────────────────────────────────────────────────────────────────────────────
// 4. TRIPS
// ─────────────────────────────────────────────────────────────────────────────

model Trip {
  id                  Int              @id @default(autoincrement())
  tripNumber          String           @unique @map("trip_number") @db.VarChar(30)
  vehicleId           Int              @map("vehicle_id")
  driverId            Int              @map("driver_id")
  sourceLocation      String           @map("source_location") @db.VarChar(100)
  destinationLocation String           @map("destination_location") @db.VarChar(100)
  scheduledDeparture  DateTime         @map("scheduled_departure") @db.Timestamptz()
  scheduledArrival    DateTime         @map("scheduled_arrival") @db.Timestamptz()
  actualDeparture     DateTime?        @map("actual_departure") @db.Timestamptz()
  actualArrival       DateTime?        @map("actual_arrival") @db.Timestamptz()
  status              String           @default("SCHEDULED") @db.VarChar(20)
  distanceKm          Decimal?         @map("distance_km") @db.Decimal(8, 2)
  passengerCount      Int?             @default(0) @map("passenger_count") @db.SmallInt
  cargoWeightKg       Decimal?         @map("cargo_weight_kg") @db.Decimal(8, 2)
  purpose             String?          @db.VarChar(255)
  cancellationReason  String?          @map("cancellation_reason") @db.Text
  notes               String?          @db.Text
  createdBy           Int              @map("created_by")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  vehicle             Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver              Driver           @relation(fields: [driverId], references: [id], onDelete: Cascade)
  creator             User             @relation("UserCreatedTrips", fields: [createdBy], references: [id], onDelete: Cascade)
  fuelLogs            FuelLog[]
  expenses            Expense[]

  @@map("trips")
}

// ─────────────────────────────────────────────────────────────────────────────
// 5. MAINTENANCE, FUEL & EXPENSES
// ─────────────────────────────────────────────────────────────────────────────

model MaintenanceLog {
  id                    Int       @id @default(autoincrement())
  vehicleId             Int       @map("vehicle_id")
  vendorId              Int?      @map("vendor_id")
  maintenanceType       String    @map("maintenance_type") @db.VarChar(20)
  description           String    @db.Text
  cost                  Decimal   @default(0.00) @db.Decimal(12, 2)
  odometerReading       Int?      @map("odometer_reading")
  startDate             DateTime  @map("start_date") @db.Date
  endDate               DateTime? @map("end_date") @db.Date
  status                String    @default("SCHEDULED") @db.VarChar(20)
  nextMaintenanceDate   DateTime? @map("next_maintenance_date") @db.Date
  nextMaintenanceOdometer Int?    @map("next_maintenance_odometer")
  partsReplaced         String?   @map("parts_replaced") @db.Text
  notes                 String?   @db.Text
  createdBy             Int       @map("created_by")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  vehicle               Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vendor                Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  creator               User      @relation("UserCreatedMaintenance", fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("maintenance_logs")
}

model FuelLog {
  id              Int          @id @default(autoincrement())
  vehicleId       Int          @map("vehicle_id")
  driverId        Int?         @map("driver_id")
  tripId          Int?         @map("trip_id")
  fuelTypeId      Int          @map("fuel_type_id")
  fuelStationId   Int?         @map("fuel_station_id")
  quantity        Decimal      @db.Decimal(8, 2)
  pricePerUnit    Decimal      @map("price_per_unit") @db.Decimal(8, 2)
  totalCost       Decimal      @map("total_cost") @db.Decimal(10, 2)
  odometerReading Int?         @map("odometer_reading")
  fuelingDate     DateTime     @map("fueling_date") @db.Timestamptz()
  receiptNumber   String?      @map("receipt_number") @db.VarChar(50)
  isFullTank      Int          @default(1) @map("is_full_tank") @db.SmallInt
  notes           String?      @db.Text
  createdBy       Int          @map("created_by")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  vehicle         Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver          Driver?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  trip            Trip?        @relation(fields: [tripId], references: [id], onDelete: SetNull)
  fuelType        FuelType     @relation(fields: [fuelTypeId], references: [id], onDelete: Cascade)
  fuelStation     FuelStation? @relation(fields: [fuelStationId], references: [id], onDelete: SetNull)
  creator         User         @relation("UserCreatedFuelLogs", fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("fuel_logs")
}

model Expense {
  id            Int       @id @default(autoincrement())
  expenseNumber String    @unique @map("expense_number") @db.VarChar(30)
  category      String    @db.VarChar(20)
  vehicleId     Int?      @map("vehicle_id")
  driverId      Int?      @map("driver_id")
  tripId        Int?      @map("trip_id")
  vendorId      Int?      @map("vendor_id")
  amount        Decimal   @db.Decimal(12, 2)
  currency      String    @default("INR") @db.Char(3)
  description   String    @db.Text
  receiptNumber String?   @map("receipt_number") @db.VarChar(50)
  expenseDate   DateTime  @map("expense_date") @db.Date
  paymentMethod String    @default("CASH") @map("payment_method") @db.VarChar(20)
  paymentStatus String    @default("PENDING") @map("payment_status") @db.VarChar(20)
  approvedBy    Int?      @map("approved_by")
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz()
  notes         String?   @db.Text
  createdBy     Int       @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  vehicle       Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver        Driver?   @relation(fields: [driverId], references: [id], onDelete: SetNull)
  trip          Trip?     @relation(fields: [tripId], references: [id], onDelete: SetNull)
  vendor        Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  approver      User?     @relation("UserApprovedExpenses", fields: [approvedBy], references: [id], onDelete: SetNull)
  creator       User      @relation("UserCreatedExpenses", fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("expenses")
}

// ─────────────────────────────────────────────────────────────────────────────
// 6. NOTIFICATIONS & OTP AUTH TABLES
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  type      String   @db.VarChar(50)
  title     String   @db.VarChar(100)
  message   String   @db.Text
  isRead    Int      @default(0) @map("is_read") @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model RegistrationOtp {
  id               Int      @id @default(autoincrement())
  email            String   @unique @db.VarChar(150)
  otpHash          String   @map("otp_hash") @db.VarChar(255)
  expiresAt        DateTime @map("expires_at") @db.Timestamptz()
  attempts         Int      @default(0)
  registrationData String   @map("registration_data") @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("registration_otp")
}

model PasswordResetOtp {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(150)
  otpHash   String   @map("otp_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("password_reset_otp")
}
